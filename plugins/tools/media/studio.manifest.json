      "id": "video.letterbox",
      "revision": 1,
      "label": "Fit video inside a frame",
      "inputs": {
        "video": {
          "kind": "video"
        }
      },
      "parameters": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4096,
            "multipleOf": 2
          },
          "height": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4096,
            "multipleOf": 2
          }
        },
        "required": [
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "output": {
        "kind": "video",
        "content_types": [
          "video/mp4"
        ]
      }
    },
