{
  "version": 1,
  "plugin": "tokencraft-speech",
  "tools": [
    {
      "id": "speech.transcribe",
      "revision": 1,
      "label": "Transcribe speech",
      "inputs": {
        "audio": {
          "kind": "audio"
        }
      },
      "parameters": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "auto",
              "en",
              "es",
              "fr",
              "de",
              "it",
              "pt",
              "ja",
              "ko",
              "zh",
              "ru",
              "ar",
              "hi"
            ],
            "default": "auto"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "kind": "document",
        "content_types": [
          "text/plain"
        ]
      }
    },
    {
